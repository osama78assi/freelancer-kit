model FreelanceService {
  id BigInt @id @default(autoincrement())
  title String @db.VarChar(400)
  content String @db.Text

  price Decimal @db.Decimal(10, 2)
  // ISO 4217 always 3 chars
  currency Currency @default(USD)
  
  parentServiceId BigInt?
  parentService FreelanceService? @relation("parentService", fields: [parentServiceId], references: [id], onDelete: Cascade)

  additionalServices FreelanceService[] @relation("parentService")

  createdAt DateTime @db.Timestamptz @default(now())
  updatedAt DateTime @db.Timestamptz @updatedAt

  @@map("freelanceServices")
}